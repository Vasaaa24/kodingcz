# --- KODING.CZ static export (Forpsi / Apache) ---

# Force HTTPS (only enable once the Let's Encrypt cert is active).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# Use the exported Next.js 404 page.
ErrorDocument 404 /404.html

# Gzip text assets.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# Cache fingerprinted Next.js assets aggressively; HTML stays fresh.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  # Public images aren't fingerprinted, so revalidate daily instead of
  # serving a stale copy for a month after the file is replaced.
  ExpiresByType image/png "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 1 day"
  ExpiresByType image/x-icon "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Fingerprinted Next.js assets (hashed filenames) can be cached forever.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
